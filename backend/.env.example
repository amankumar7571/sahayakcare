# Copy to .env for local development. Never commit a real .env.
# Generate a secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
# (Or export SAHAYAKCARE_ALLOW_DEV_SECRET=1 to use a random per-process
# secret for local dev — tokens do not survive a restart.)
JWT_SECRET_KEY=your-long-random-secret-here
CORS_ALLOW_ORIGINS=*
# DATABASE_URL=sqlite:///./sahayakcare.db
